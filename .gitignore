# ==========================================
# No Documents, Presentations or Compressed Archives
# ==========================================
*.pdf
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
*.zip
*.rar
*.7z
*.tar.gz

# ==========================================
# Dependencies & Package Managers
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Build Artifacts & Output Directories
# ==========================================
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo

# ==========================================
# Python & Notebook Checkpoints
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/
venv/
.venv/
env/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# Databases & Local Logs
# ==========================================
*.sqlite
*.db
*.db-journal
*.log

# ==========================================
# IDEs & Operating Systems
# ==========================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
