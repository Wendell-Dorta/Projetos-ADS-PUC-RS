datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Cliente {
  codigo       Int          @id @default(autoincrement())
  nome         String
  email        String       @unique
  assinaturas  Assinatura[]

  @@map("clientes")
}

model Plano {
  codigo       Int          @id @default(autoincrement())
  nome         String
  custoMensal  Float
  data         DateTime     @default(now())
  descricao    String
  assinaturas  Assinatura[]

  @@map("planos")
}

model Assinatura {
  codigo              Int      @id @default(autoincrement())
  codPlano            Int
  codCli              Int
  inicioFidelidade    DateTime
  fimFidelidade       DateTime
  dataUltimoPagamento DateTime
  custoFinal          Float
  descricao           String

  cliente             Cliente  @relation(fields: [codCli], references: [codigo])
  plano               Plano    @relation(fields: [codPlano], references: [codigo])

  @@index([codCli])
  @@index([codPlano])
  @@index([dataUltimoPagamento])

  @@map("assinaturas")
}
